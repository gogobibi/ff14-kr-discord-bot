# ===== 필수 =====
# Discord Bot Token (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=
# DeepSeek API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# ===== 선택 (기본값 있음, 비워두면 기본값 사용) =====
# CLASSIFIER_PROVIDER=deepseek         # 'deepseek' (기본) | 'gemini'
# CLASSIFIER_BATCH_SIZE=3              # 한 LLM 호출에 묶을 이벤트 수 (보수적 권장 2~3)
# DEEPSEEK_MODEL=deepseek-v4-flash     # 기본값. 'deepseek-v4-pro' 로 thinking 모드
# DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions

# ===== 개발/테스트 전용 (운영에서는 불필요) =====
# /이벤트-스크래핑 수동 트리거 명령을 노출할 길드 ID (cron 자동 스크래핑은 무관)
# DEV_GUILD_ID=

# Gemini provider 전환 시에만 필요
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# scripts/test-notify.js / scripts/test-dday.js 실행 시 발송 대상 길드 ID
# 미설정 시 두 스크립트는 즉시 종료 (운영 길드 스팸 방지)
# TEST_GUILD_ID=
