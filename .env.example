# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DEV_GUILD_ID=                       # /이벤트-스크래핑 dev 명령이 노출될 길드 ID

# --- Classifier (LLM) ---
CLASSIFIER_PROVIDER=deepseek         # 'deepseek' (기본) | 'gemini'
CLASSIFIER_BATCH_SIZE=3              # 한 LLM 호출에 묶을 이벤트 수 (보수적 권장 2~3)

# DeepSeek (현재 기본 provider)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash   # 기본값. 'deepseek-v4-pro' 로 thinking 모드
# DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions

# Gemini (provider 전환 시)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- 테스트 전용 ---
# scripts/test-notify.js / scripts/test-dday.js 가 실 발송 시 검증할 길드 ID
# 미설정 시 두 스크립트는 즉시 종료 (운영 길드 스팸 방지)
TEST_GUILD_ID=
